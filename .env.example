# PDFNova Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# ─── Backend Server ──────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── Security ────────────────────────────────────────────────────────────────
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# ─── CORS ────────────────────────────────────────────────────────────────────
# Your public frontend URL (no trailing slash)
# Example: https://pdfnova.yourdomain.com
FRONTEND_URL=https://pdfnova.yourdomain.com

# ─── API URL (used in frontend config.js) ────────────────────────────────────
# Your public backend URL (no trailing slash)
# Example: https://api.pdfnova.yourdomain.com
BACKEND_URL=https://api.pdfnova.yourdomain.com

# ─── Database (if using PostgreSQL instead of file-based storage) ─────────────
# Example: postgresql://user:password@host:5432/pdfnova
DATABASE_URL=
